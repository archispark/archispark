# ─────────────────────────────────────────────────────────────────────────────
#  ArchiSpark Docker — Variables d'environnement
#  Copier ce fichier : cp .env.example .env.dev (ou .env.prod) — ou `pnpm env`.
#  Ne jamais commiter .env.dev / .env.prod dans git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Image de base ─────────────────────────────────────────────────────────────
# alpine      → node:22-alpine      (images légères, musl libc)
# trixie-slim → node:22-trixie-slim (Debian Testing, glibc)
ARCHISPARK_OS=alpine

# ── Version des images ────────────────────────────────────────────────────────
# Tag Docker Hub utilisé par docker-compose.yml (ex: latest, 0.5.2)
ARCHISPARK_VERSION=latest

# ── URL publique ────────────────────────────────────────────────────────────
# Utilisée par apps/server pour construire les liens d'invitation par e-mail
# (jamais reconstruite depuis l'en-tête Host, qui est contrôlable par
# l'appelant).
ARCHISPARK_URL=http://localhost:8000

# ── Base de données ─────────────────────────────────────────────────────────
DB_PASSWORD=archispark

# Connexion poolée utilisée par apps/server — base unique partagée (auth/
# tokens et contenu ArchiMate).
# En local : Postgres exposé sur localhost:5432 par `pnpm up`.
# Sur Vercel : Neon injecte automatiquement DATABASE_URL (pooled) via Marketplace.
DATABASE_URL=postgresql://archispark:${DB_PASSWORD}@localhost:5432/archispark

# Connexion directe (non-poolée) — migrations manuelles et seed depuis CI/CD.
# Sur Vercel / Neon : DATABASE_URL_UNPOOLED (auto-injecté par Neon Marketplace).
# En local : même URL que DATABASE_URL (pg.Pool gère lui-même le pooling).
#DATABASE_URL_UNPOOLED=postgresql://archispark:${DB_PASSWORD}@localhost:5432/archispark

# ── Neo4j — export du modèle pour reporting ─────────────────────────────────
# Utilisé par apps/server (packages/db-neo4j) pour synchroniser le modèle
# ArchiMate d'un workspace (lu depuis Postgres) vers un graphe Neo4j.
# En local : Neo4j exposé sur bolt://localhost:7687 par `pnpm up`, sans
# authentification (NEO4J_AUTH: none) — NEO4J_USER/NEO4J_PASSWORD restent vides.
# En prod (docker-compose.yml) : NEO4J_PASSWORD active l'authentification du
# service neo4j (utilisateur "neo4j") et est réutilisé tel quel par apps/server.
NEO4J_URI=bolt://localhost:7687
#NEO4J_USER=
NEO4J_PASSWORD=archispark

# ── Vercel Blob — bibliothèque d'images personnalisées (packs d'organisation) ─
# Requis pour uploader des images dans un pack personnalisé (@vercel/blob).
# Créer un Blob store depuis Vercel → Storage puis copier son "Read/Write
# Token" ; en local, il n'y a pas d'équivalent auto-hébergé pour
# docker-compose. Sans cette variable, l'upload de pack personnalisé échoue
# proprement (422) ; le pack système (icônes ArchiMate) reste utilisable.
#BLOB_READ_WRITE_TOKEN=

# ── Authentification locale (login/mot de passe) ────────────────────────────
# Méthode d'authentification par défaut (table `users`, voir
# packages/auth/src/local-jwt.ts) — Keycloak SSO ci-dessous reste optionnel.
# Secret de signature des access tokens locaux (HS256) : générer une valeur
# aléatoire d'au moins 32 caractères en production (ex: `openssl rand -base64 32`).
LOCAL_AUTH_JWT_SECRET=change-me-in-production-32-chars-minimum

# ── Keycloak — local dev ─────────────────────────────────────────────────────
# Bootstrap superuser pour la console d'administration Keycloak (dev only).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Propose Keycloak comme option de connexion SSO en plus des comptes locaux
# ci-dessus (bouton « Continuer avec {name} » sur la page de connexion,
# apps/server/app/api/auth/providers/route.ts) — false par défaut.
KEYCLOAK_SSO_ENABLED=false
# Nom affiché sur le bouton SSO (facultatif, "Keycloak" par défaut).
#KEYCLOAK_SSO_PROVIDER_NAME=Keycloak

# Utilisé par packages/auth (apps/server) pour vérifier les access tokens via JWKS.
# KEYCLOAK_URL est le même Keycloak partagé pour tous les déploiements ;
# KEYCLOAK_REALM varie par déploiement (un realm dédié par client — voir
# docs/deployment.md#onboarding-dun-nouveau-client-un-realm-keycloak-dédié).
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=archispark

# Client ID public (utilisé par web à partir de l'étape 3).
KEYCLOAK_CLIENT_ID_WEB=archispark-web

# Client confidentiel / service account du serveur (Admin API, étape 5+).
KEYCLOAK_ADMIN_CLIENT_ID=archispark-api
KEYCLOAK_ADMIN_CLIENT_SECRET=archispark-api-secret

# Auto-inscription Keycloak + invitations par e-mail (organisation.ts,
# apps/server/lib/archimate/invitations-store.ts) — n'a d'effet que si explicitement
# définie (voir packages/db/scripts/setup-realm.ts). Le realm `archispark`
# de dev EST le realm mutualisé de référence, donc activée ici ; un realm
# dédié à un client ne doit PAS définir ces deux variables (config du realm
# inchangée par défaut — voir docs/deployment.md).
# Le realm local autorise l'inscription, vérifie l'adresse via Mailpit et
# propose « mot de passe oublié ». Les realms dédiés restent désactivés par
# défaut tant que ces variables ne leur sont pas fournies explicitement.
KEYCLOAK_SELF_REGISTRATION=true
KEYCLOAK_VERIFY_EMAIL=true
KEYCLOAK_RESET_PASSWORD=true

# ── Invitations par e-mail (SMTP) ───────────────────────────────────────────
# Utilisé à la fois par apps/server (e-mail "vous êtes invité", nodemailer) et
# par Keycloak lui-même (e-mail natif de vérification d'adresse après
# inscription — voir setup-realm.ts). Laisser SMTP_HOST vide désactive
# l'envoi (l'invitation reste créée mais sentAt=null, voir docs/architecture.md).
# apps/docs réutilise le même SMTP_* pour le formulaire de contact de la
# landing page (apps/docs/lib/contact.ts) — un seul serveur SMTP (ex. OVH en
# production) pour tout le monorepo. CONTACT_TO_EMAIL est la boîte qui reçoit
# les messages du formulaire ; sans SMTP_HOST ni CONTACT_TO_EMAIL, la route
# /api/contact répond 502 et le reste de la landing page reste utilisable.
SMTP_HOST=localhost
# Keycloak tourne dans Docker et joint Mailpit par son nom de service.
KEYCLOAK_SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@archispark.local
CONTACT_TO_EMAIL=contact@archispark.io

# ── MCP ─────────────────────────────────────────────────────────────────────
# Pas de variable d'URL à définir : le transport MCP est servi par ce même
# déploiement (/mcp/, voir apps/server/pages/api/mcp.ts et le rewrite dans
# next.config.ts) — l'URL affichée dans la configuration Claude Code est
# calculée côté client depuis window.location.origin.
# Authentification MCP : token API personnel (menu utilisateur → Tokens API),
# même mécanisme que le reste de la REST API — pas de variable dédiée.

# ── Domaines — Docker Compose de production uniquement ─────────────────────
# Utilisés par les règles Host() des labels Traefik de docker-compose.prod.yml.
# ARCHISPARK_URL et KEYCLOAK_URL ci-dessus restent les URLs complètes utilisées
# par l'application elle-même.
#ARCHISPARK_DOMAIN=archispark.example.com
#KEYCLOAK_DOMAIN=auth.archispark.example.com

# ── TLS Let's Encrypt — Traefik uniquement ────────────────────────────────
#ACME_EMAIL=votre@email.com
