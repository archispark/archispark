{
  "name": "server",
  "version": "0.1.0",
  "description": "ArchiSpark unified server — web UI, REST API, and MCP server (Next.js, PostgreSQL, Keycloak)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "[ ! -f ../../.env ] || { set -a && . ../../.env && set +a; }; next dev --turbopack --hostname 0.0.0.0 --port 8000",
    "build": "next build",
    "start": "[ ! -f ../../.env ] || { set -a && . ../../.env && set +a; }; next start --hostname 0.0.0.0 --port 8000",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@dagrejs/dagre": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@workspace/auth": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/db-neo4j": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@xyflow/react": "^12.11.0",
    "archiver": "^8.0.0",
    "colord": "^2.9.3",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.8.0",
    "html-to-image": "^1.11.13",
    "lru-cache": "^11.5.1",
    "lucide-react": "^1.17.0",
    "neo4j-driver": "^6.2.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "sonner": "^2.0.7",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "jsdom": "^29.1.1",
    "supertest": "^7.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
