{
  "name": "server",
  "version": "0.1.0",
  "description": "ArchiSpark unified server — web UI, REST API, and MCP server (Next.js, PostgreSQL, Keycloak)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0 --port 8000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 8000",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx scripts/generate-openapi.ts",
    "gen:icon-pack": "tsx scripts/generate-archimate-icon-pack.ts",
    "gen:cloud-icon-packs": "tsx scripts/generate-cloud-icon-packs.ts",
    "gen:plugin-registry": "tsx scripts/generate-plugin-registry.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@dagrejs/dagre": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@workspace/auth": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/db-neo4j": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/image-library": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@xyflow/react": "^12.11.6",
    "archiver": "^8.0.0",
    "colord": "^2.10.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "html-to-image": "^1.11.13",
    "lru-cache": "^11.5.2",
    "lucide-react": "^1.41.0",
    "neo4j-driver": "^6.2.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "sonner": "^2.0.8",
    "use-debounce": "^10.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
