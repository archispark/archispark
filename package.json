{
  "name": "archispark",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm run infra:up && set -a && . ./.env && set +a && turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo run test:coverage --filter=server --filter=@workspace/db --filter=@workspace/db-neo4j",
    "env": "[ -f .env ] || (cp .env.example .env && echo 'Fichier .env créé depuis .env.example — modifiez-le avant de lancer l’application.')",
    "start": "pnpm run infra:up && set -a && . ./.env && set +a && pnpm --filter server start",
    "stop": "docker compose -f .docker/docker-compose.yml down",
    "restart": "pnpm run stop && pnpm run start",
    "infra:up": "docker compose -f .docker/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f .docker/docker-compose.yml down",
    "migrate:db": "set -a && . ./.env && set +a && pnpm --filter @workspace/db migrate:prod",
    "backfill:db": "set -a && . ./.env && set +a && pnpm --filter @workspace/db backfill:prod",
    "migrate:neo4j": "set -a && . ./.env && set +a && pnpm --filter @workspace/db-neo4j migrate:prod",
    "seed": "pnpm run seed:keycloak && pnpm run seed:demo-users && pnpm run seed:demo && pnpm run seed:dashboards",
    "seed:keycloak": "set -a && . ./.env && set +a && pnpm setup:realm",
    "seed:demo-users": "set -a && . ./.env && set +a && pnpm --filter @workspace/db seed:demo-users",
    "seed:demo": "set -a && . ./.env && set +a && pnpm --filter @workspace/db seed:demo",
    "seed:dashboards": "set -a && . ./.env && set +a && pnpm --filter @workspace/db seed:dashboards",
    "setup:realm": "pnpm --filter @workspace/db setup:realm",
    "import:workspace": "pnpm --filter @workspace/db-neo4j import:workspace",
    "import:workspaces": "pnpm --filter @workspace/db-neo4j import:workspaces",
    "reset": "pnpm run reset:db && pnpm run reset:neo4j && pnpm run migrate:db && pnpm run backfill:db && pnpm run migrate:neo4j",
    "reset:db": "set -a && . ./.env && set +a && pnpm --filter @workspace/db reset",
    "reset:neo4j": "set -a && . ./.env && set +a && pnpm --filter @workspace/db-neo4j reset",
    "reset-demo": "pnpm run reset && pnpm run seed && pnpm import:workspace"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.8",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.13"
  }
}
