{
  "name": "archispark",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=server",
    "dev:docs": "turbo dev --filter=@archispark/docs",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo run test:coverage --filter=server --filter=@workspace/db --filter=@workspace/db-neo4j --filter=@workspace/env --filter=@archispark/docs",
    "env": "[ -f .env ] || (cp .env.example .env && echo 'Fichier .env créé depuis .env.example — modifiez-le avant de lancer l’application.')",
    "start": "pnpm --filter server start",
    "start:docs": "pnpm --filter @archispark/docs start",
    "stop": "pnpm run infra:down",
    "infra:up": "docker compose -f .docker/docker-compose.yml --profile auth --profile mail --profile neo4j up -d --wait",
    "infra:up:db": "docker compose -f .docker/docker-compose.yml up -d --wait",
    "infra:up:mail": "docker compose -f .docker/docker-compose.yml --profile mail up -d --wait",
    "infra:up:auth": "docker compose -f .docker/docker-compose.yml --profile auth up -d --wait",
    "infra:up:neo4j": "docker compose -f .docker/docker-compose.yml --profile neo4j up -d --wait",
    "infra:down": "docker compose -f .docker/docker-compose.yml --profile auth --profile mail --profile neo4j down",
    "prod:up": "docker compose -f .docker/docker-compose.prod.yml --env-file .env.prod up -d --wait",
    "prod:down": "docker compose -f .docker/docker-compose.prod.yml --env-file .env.prod down",
    "db:migrate": "pnpm run db:migrate:postgres && pnpm run db:migrate:backfill && pnpm run db:migrate:neo4j",
    "db:migrate:postgres": "pnpm --filter @workspace/db migrate:prod",
    "db:migrate:backfill": "pnpm --filter @workspace/db backfill:prod",
    "db:migrate:neo4j": "pnpm --filter @workspace/db-neo4j migrate:prod",
    "seed": "pnpm run seed:keycloak && pnpm run seed:demo-users && pnpm run seed:demo && pnpm run seed:dashboards",
    "seed:keycloak": "pnpm setup:realm",
    "seed:demo-users": "pnpm --filter @workspace/db seed:demo-users",
    "seed:minimal-users": "pnpm --filter @workspace/db seed:minimal-users",
    "seed:minimal": "pnpm run seed:keycloak && pnpm run seed:minimal-users",
    "seed:local-admin": "pnpm --filter @workspace/db seed:local-admin",
    "seed:demo": "pnpm --filter @workspace/db seed:demo",
    "seed:dashboards": "pnpm --filter @workspace/db seed:dashboards",
    "setup:realm": "pnpm --filter @workspace/db setup:realm",
    "import:workspace": "pnpm --filter @workspace/db-neo4j import:workspace",
    "import:workspaces": "pnpm --filter @workspace/db-neo4j import:workspaces",
    "db:reset": "pnpm run db:reset:postgres && pnpm run db:reset:neo4j && pnpm run migrate",
    "db:reset:postgres": "pnpm --filter @workspace/db reset",
    "db:reset:neo4j": "pnpm --filter @workspace/db-neo4j reset",
    "db:reset-demo": "pnpm run db:reset && pnpm run seed && pnpm run import:workspaces"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.8",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.13"
  }
}
