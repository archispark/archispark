{
  "name": "archispark",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo run test:coverage --filter=server --filter=@workspace/db --filter=@workspace/db-neo4j",

    "env": "[ -f .env.dev ] || (cp .env.example .env.dev && echo 'Fichier .env.dev créé depuis .env.example — modifiez-le avant `pnpm up`.')",
    "env:prod": "[ -f .env.prod ] || (cp .env.example .env.prod && echo 'Fichier .env.prod créé depuis .env.example — modifiez-le avant `pnpm up:prod`.')",

    "up": "pnpm run env && docker compose -f .docker/docker-compose.dev.yml --env-file .env.dev up -d --wait && pnpm dev",
    "down": "docker compose -f .docker/docker-compose.dev.yml --env-file .env.dev down",
    "restart": "docker compose -f .docker/docker-compose.dev.yml --env-file .env.dev restart",
    "logs": "docker compose -f .docker/docker-compose.dev.yml --env-file .env.dev logs -f",
    "ps": "docker compose -f .docker/docker-compose.dev.yml --env-file .env.dev ps",

    "up:prod": "pnpm run env:prod && docker compose -f .docker/docker-compose.yml --env-file .env.prod up -d",
    "down:prod": "docker compose -f .docker/docker-compose.yml --env-file .env.prod down",
    "restart:prod": "docker compose -f .docker/docker-compose.yml --env-file .env.prod restart",
    "logs:prod": "docker compose -f .docker/docker-compose.yml --env-file .env.prod logs -f",
    "ps:prod": "docker compose -f .docker/docker-compose.yml --env-file .env.prod ps",
    "pull:prod": "docker compose -f .docker/docker-compose.yml --env-file .env.prod pull",

    "keycloak-setup": "pnpm run env && set -a && . ./.env.dev && set +a && pnpm setup:realm",
    "seed-demo-users": "pnpm run env && set -a && . ./.env.dev && set +a && pnpm seed:demo-users",
    "seed-demo": "pnpm run env && set -a && . ./.env.dev && set +a && pnpm seed:demo",
    "setup-demo": "pnpm run keycloak-setup && pnpm run seed-demo-users && pnpm run seed-demo",

    "seed:demo": "pnpm --filter @workspace/db seed:demo",
    "seed:demo-users": "pnpm --filter @workspace/db seed:demo-users",
    "setup:realm": "pnpm --filter @workspace/db setup:realm",
    "import:workspace": "pnpm --filter @workspace/db-neo4j import:workspace",
    "import:workspaces": "pnpm --filter @workspace/db-neo4j import:workspaces",

    "docker:build": "docker build --file .docker/server/${OS:-alpine}/Dockerfile --tag ${REGISTRY:-archispark}/archispark-server:${OS:-alpine}-$(pnpm pkg get version) --tag ${REGISTRY:-archispark}/archispark-server:${OS:-alpine}-latest .",
    "docker:build:trixie-slim": "OS=trixie-slim pnpm run docker:build",
    "docker:build:all": "pnpm run docker:build && OS=trixie-slim pnpm run docker:build",
    "docker:clean": "docker images --filter reference=\"${REGISTRY:-archispark}/archispark-*\" -q | xargs -r docker rmi -f",
    "docker:prune": "docker system prune -f"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.17",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.13"
  }
}
