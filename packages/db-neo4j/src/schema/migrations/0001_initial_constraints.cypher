CREATE CONSTRAINT element_id IF NOT EXISTS FOR (n:Element) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT view_id IF NOT EXISTS FOR (v:View) REQUIRE v.id IS UNIQUE;
CREATE CONSTRAINT model_id IF NOT EXISTS FOR (m:Model) REQUIRE m.id IS UNIQUE;
CREATE CONSTRAINT schema_migration_version IF NOT EXISTS FOR (sm:SchemaMigration) REQUIRE sm.version IS UNIQUE;
CREATE INDEX property_lookup IF NOT EXISTS FOR (p:Property) ON (p.name, p.value);
CREATE CONSTRAINT rel_id_composition IF NOT EXISTS FOR ()-[r:COMPOSITION]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT rel_id_aggregation IF NOT EXISTS FOR ()-[r:AGGREGATION]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT rel_id_assignment IF NOT EXISTS FOR ()-[r:ASSIGNMENT]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT rel_id_realization IF NOT EXISTS FOR ()-[r:REALIZATION]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT rel_id_serving IF NOT EXISTS FOR ()-[r:SERVING]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT rel_id_access IF NOT EXISTS FOR ()-[r:ACCESS]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT rel_id_influence IF NOT EXISTS FOR ()-[r:INFLUENCE]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT rel_id_triggering IF NOT EXISTS FOR ()-[r:TRIGGERING]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT rel_id_flow IF NOT EXISTS FOR ()-[r:FLOW]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT rel_id_specialization IF NOT EXISTS FOR ()-[r:SPECIALIZATION]-() REQUIRE r.id IS UNIQUE;
CREATE CONSTRAINT rel_id_association IF NOT EXISTS FOR ()-[r:ASSOCIATION]-() REQUIRE r.id IS UNIQUE;
