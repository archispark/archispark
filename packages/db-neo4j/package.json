{
  "name": "@workspace/db-neo4j",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/schema/migrations dist/schema/migrations",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "migrate:prod": "tsx scripts/migrate-prod.ts",
    "import:workspace": "tsx scripts/import-workspace.ts",
    "import:workspaces": "tsx scripts/import-all-workspaces.ts"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "neo4j-driver": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@workspace/typescript-config": "workspace:*",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
