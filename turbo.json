{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["DB_CLIENT"]
    },
    "test": {
      "cache": false
    },
    "test:coverage": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "ARCHISPARK_URL",
        "LOCAL_AUTH_JWT_SECRET",
        "KEYCLOAK_URL",
        "KEYCLOAK_REALM",
        "KEYCLOAK_CLIENT_ID_WEB",
        "KEYCLOAK_ADMIN_CLIENT_ID",
        "KEYCLOAK_ADMIN_CLIENT_SECRET",
        "KEYCLOAK_SSO_ENABLED",
        "KEYCLOAK_SSO_PROVIDER_NAME",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_STARTTLS",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "SMTP_FROM",
        "NEO4J_URI",
        "NEO4J_USER",
        "NEO4J_PASSWORD",
        "BLOB_READ_WRITE_TOKEN",
        "NODE_OPTIONS",
        "PORT",
        "HOST"
      ]
    }
  }
}
